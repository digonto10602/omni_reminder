pkgname=omni-reminder
pkgver=0.1.0
pkgrel=2
pkgdesc='Transparent reminder overlay for Omarchy with hold-to-record voice memos'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'ffmpeg' 'libnotify' 'pipewire-pulse')
optdepends=('superwhisper-bin: turn voice memos into text')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omni-reminder "$pkgdir/usr/bin/omni-reminder"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omni-reminder.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omni-reminder.svg"
  install -Dm644 "$startdir/omni-reminder.desktop" "$pkgdir/usr/share/applications/omni-reminder.desktop"
}
